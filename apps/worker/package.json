  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@rjpos/database": "workspace:*",
    "@rjpos/logging": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
