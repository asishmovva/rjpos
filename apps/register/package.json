{
  "name": "@rjpos/register",
  "version": "0.0.0",
  "description": "Secure RJ POS Windows register application",
  "author": "RJ POS",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-renderer.mjs",
    "start": "electron .",
    "dev": "pnpm build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package:win": "pnpm --filter @rjpos/web build && pnpm build && electron-builder --win nsis"
  },
  "dependencies": {
    "@rjpos/hardware-contracts": "workspace:*",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.rjpos.register",
    "productName": "RJ POS Register",
    "artifactName": "RJ-POS-Register-${version}-${arch}.${ext}",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "package.json"],
    "extraResources": [{ "from": "../web/out", "to": "renderer" }],
    "win": { "target": ["nsis"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "deleteAppDataOnUninstall": false }
  }
}
