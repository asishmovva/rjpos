NODE_ENV=development
DATABASE_URL=postgresql://rjpos:rjpos@127.0.0.1:15432/rjpos
REDIS_URL=redis://localhost:6379
AUTH_PROVIDER=development
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
RJPOS_RENDERER_URL=http://localhost:3000
NEXT_PUBLIC_RJPOS_API_URL=http://127.0.0.1:3001/api/v1
RJPOS_API_URL=http://127.0.0.1:3001/api/v1
RJPOS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,rjpos://app
RJPOS_HARDWARE_MODE=simulated
# Production terminal adapter: set all three only after a certified provider endpoint is available.
RJPOS_TERMINAL_PROVIDER=simulated
# Development-only deterministic normalized invoice fixture provider. Production defaults to unavailable until a real OCR adapter is configured.
RJPOS_INVOICE_OCR_PROVIDER=fixture
RJPOS_TERMINAL_ENDPOINT=
RJPOS_TERMINAL_TOKEN=

# Dedicated integration-test services. Never point these at the development database or Redis instance.
TEST_DATABASE_URL=postgresql://rjpos_test:rjpos_test@127.0.0.1:15433/rjpos_test
TEST_REDIS_URL=redis://127.0.0.1:6380
TEST_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
TEST_STORE_ID=00000000-0000-0000-0000-000000000002
TEST_VARIANT_ID=00000000-0000-0000-0000-000000000009
TEST_ORDER_ID_ONE=00000000-0000-0000-0000-000000000010
TEST_ORDER_ID_TWO=00000000-0000-0000-0000-000000000011

# ---- Production (NODE_ENV=production). The API refuses to start if these are unsafe (see apps/api/src/production-config.ts). ----
# RJPOS_ELEVATION_SECRET=<32+ random characters; signs PIN sessions and manager approvals>
# RJPOS_ORGANIZATION_ID=<uuid>   # the organization this server serves
# RJPOS_STORE_ID=<uuid>          # the store this server serves
# RJPOS_REGISTER_ID=<uuid>       # optional default register; registers may also send their own id
# RJPOS_ALLOWED_ORIGINS=rjpos://app,https://backoffice.example.com
# RJPOS_TERMINAL_PROVIDER=http   # 'simulated' is rejected in production; unset means payments are unavailable
# RJPOS_BACKUP_DIR=../../backups # where scripts/backup-database.ps1 writes status.json
# RJPOS_HELD_SALE_TTL_HOURS=24   # held sales older than this expire
# Web build: NEXT_PUBLIC_RJPOS_AUTH_MODE=production makes back office require a Manager/Owner PIN.
