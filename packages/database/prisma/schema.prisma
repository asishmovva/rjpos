generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductUnit {
  EACH
  ML
  LITER
}

enum RegisterStatus {
  ACTIVE
  INACTIVE
}

enum StoreStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum PaymentAccountStatus {
  ACTIVE
  INACTIVE
}

enum PaymentEnvironment {
  SANDBOX
  PRODUCTION
}

enum TerminalStatus {
  UNPAIRED
  PAIRED
  CONNECTED
  DISCONNECTED
  DECOMMISSIONED
}

enum RegisterSessionStatus {
  OPEN
  CLOSING
  CLOSED
}

enum InventoryMovementType {
  INITIAL
  SALE
  SALE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RECEIVING
  PURCHASE_RECEIPT
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
  VOID_REVERSAL
  RETURN_NON_RESELLABLE
  VENDOR_RETURN
}

enum ReservationStatus {
  ACTIVE
  CONVERTED
  RELEASED
  EXPIRED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

enum PaymentKind {
  CASH
  TERMINAL
  GIFT_CARD
  LOYALTY
}

enum LedgerStatus {
  PENDING
  POSTED
  CANCELLED
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  REVERSAL
}

enum GiftCardStatus {
  ACTIVE
  DISABLED
}

enum GiftCardTransactionType {
  ISSUE
  RELOAD
  REDEEM
  REFUND
  REVERSAL
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum InvoiceOcrStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum InvoiceReviewStatus {
  DRAFT
  CONFIRMED
  REJECTED
}

enum InvoiceLineMatchStatus {
  MATCHED
  MASTER_CATALOG
  NEEDS_REVIEW
  NEW_PRODUCT
  INVALID
}

enum InventoryTransferStatus {
  DRAFT
  SUBMITTED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum StockCountStatus {
  DRAFT
  REVIEWED
  FINALIZED
  CANCELLED
}

enum PromotionType {
  PERCENTAGE
  FIXED
  MULTIBUY
}

enum PromotionScope {
  VARIANT
  PRODUCT
  CATEGORY
}

enum HeldTransactionStatus {
  HELD
  RESUMED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  CREATED
  PROCESSING
  AUTHORIZED
  CAPTURED
  DECLINED
  CANCELLED
  UNKNOWN
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentAttemptStatus {
  CREATED
  PROCESSING
  SUCCEEDED
  DECLINED
  CANCELLED
  UNKNOWN
  FAILED
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  UNKNOWN
  CANCELLED
}

enum RefundAttemptStatus {
  CREATED
  PROCESSING
  SUCCEEDED
  FAILED
  UNKNOWN
  CANCELLED
}

enum IdempotencyStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model Organization {
  id                     String                         @id @default(uuid()) @db.Uuid
  name                   String
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  stores                 Store[]
  employees              Employee[]
  employeeShifts         EmployeeShift[]
  employeeStores         EmployeeStore[]
  roles                  Role[]
  permissions            Permission[]
  employeeRoles          EmployeeRole[]
  rolePermissions        RolePermission[]
  categories             Category[]
  products               Product[]
  variants               ProductVariant[]
  barcodes               Barcode[]
  prices                 Price[]
  inventoryLevels        InventoryLevel[]
  inventoryMovements     InventoryMovement[]
  reservations           InventoryReservation[]
  registers              Register[]
  sessions               RegisterSession[]
  customers              Customer[]
  loyaltyProgram         LoyaltyProgram?
  loyaltyTransactions    LoyaltyTransaction[]
  giftCards              GiftCard[]
  giftCardTransactions   GiftCardTransaction[]
  orders                 Order[]
  payments               Payment[]
  refundItems            RefundItem[]
  reservationLines       InventoryReservationLine[]
  paymentAccounts        MerchantPaymentAccount[]
  terminals              TerminalDevice[]
  assignments            TerminalAssignment[]
  idempotencyKeys        IdempotencyKey[]
  auditRecords           AuditRecord[]
  outboxEvents           OutboxEvent[]
  vendors                Vendor[]
  vendorProductMappings  VendorProductMapping[]
  purchaseOrders         PurchaseOrder[]
  purchaseReceipts       PurchaseReceipt[]
  purchaseOrderLines     PurchaseOrderLine[]
  purchaseReceiptLines   PurchaseReceiptLine[]
  storeProductCosts      StoreProductCost[]
  inventoryTransfers     InventoryTransfer[]
  inventoryTransferLines InventoryTransferLine[]
  transferReceipts       InventoryTransferReceipt[]
  transferReceiptLines   InventoryTransferReceiptLine[]
  stockCounts            StockCount[]
  stockCountLines        StockCountLine[]
  promotions             Promotion[]
  quickKeys              QuickKey[]
  heldTransactions       HeldTransaction[]
  invoiceDocuments       InvoiceDocument[]
  invoiceLines           InvoiceLine[]
  taxProfiles            TaxProfile[]
  priceBooks             PriceBook[]
  specialPrices          SpecialPrice[]
  vendorDeals            VendorDeal[]
  costHistory            ProductCostHistory[]
  cashMovements          CashMovement[]
  dayCloses              DayClose[]
  salesChannels          SalesChannel[]
  vendorClaims           VendorClaim[]
  vendorClaimLines       VendorClaimLine[]
}

model Store {
  id                  String                   @id @default(uuid()) @db.Uuid
  organizationId      String                   @db.Uuid
  name                String
  addressJson         Json?
  taxRateBasisPoints  Int                      @default(0)
  timezone            String                   @default("America/New_York")
  status              StoreStatus              @default(ACTIVE)
  receiptFooter       String?
  ageRestrictionLabel String                   @default("21+")
  organization        Organization             @relation(fields: [organizationId], references: [id])
  registers           Register[]
  employees           EmployeeStore[]
  employeeShifts      EmployeeShift[]
  prices              Price[]
  inventoryLevels     InventoryLevel[]
  movements           InventoryMovement[]
  reservations        InventoryReservation[]
  sessions            RegisterSession[]
  customers           Customer[]
  orders              Order[]
  paymentAccounts     MerchantPaymentAccount[]
  terminals           TerminalDevice[]
  assignments         TerminalAssignment[]
  purchaseOrders      PurchaseOrder[]
  productCosts        StoreProductCost[]
  outboundTransfers   InventoryTransfer[]      @relation("TransferSourceStore")
  inboundTransfers    InventoryTransfer[]      @relation("TransferDestinationStore")
  stockCounts         StockCount[]
  promotions          Promotion[]
  quickKeys           QuickKey[]
  heldTransactions    HeldTransaction[]
  invoiceDocuments    InvoiceDocument[]
  specialPrices       SpecialPrice[]
  dayCloses           DayClose[]

  @@unique([organizationId, id])
  @@index([organizationId, name])
  @@index([organizationId, status, name], map: "Store_organizationId_status_name_idx")
}

model Employee {
  id                    String                     @id @default(uuid()) @db.Uuid
  organizationId        String                     @db.Uuid
  firstName             String
  lastName              String
  status                EmployeeStatus             @default(ACTIVE)
  pinHash               String?
  /// Bumped to revoke every outstanding session for this employee (deactivation, role change, PIN reset).
  sessionVersion        Int                        @default(0)
  organization          Organization               @relation(fields: [organizationId], references: [id])
  stores                EmployeeStore[]
  sessions              RegisterSession[]          @relation("RegisterSessionOpenedBy")
  inventoryMovements    InventoryMovement[]
  refunds               Refund[]
  ageVerifiedOrders     Order[]                    @relation("OrderAgeVerifiedBy")
  roles                 EmployeeRole[]
  closedSessions        RegisterSession[]          @relation("RegisterSessionClosedBy")
  shifts                EmployeeShift[]            @relation("EmployeeShiftEmployee")
  correctedShifts       EmployeeShift[]            @relation("EmployeeShiftCorrectedBy")
  loyaltyAdjustments    LoyaltyTransaction[]       @relation("LoyaltyTransactionEmployee")
  giftCardTransactions  GiftCardTransaction[]      @relation("GiftCardTransactionEmployee")
  createdPurchaseOrders PurchaseOrder[]
  purchaseReceipts      PurchaseReceipt[]
  createdTransfers      InventoryTransfer[]        @relation("TransferCreatedBy")
  submittedTransfers    InventoryTransfer[]        @relation("TransferSubmittedBy")
  shippedTransfers      InventoryTransfer[]        @relation("TransferShippedBy")
  receivedTransfers     InventoryTransferReceipt[] @relation("TransferReceivedBy")
  createdStockCounts    StockCount[]               @relation("StockCountCreatedBy")
  reviewedStockCounts   StockCount[]               @relation("StockCountReviewedBy")
  finalizedStockCounts  StockCount[]               @relation("StockCountFinalizedBy")
  createdPromotions     Promotion[]                @relation("PromotionCreatedBy")
  heldTransactions      HeldTransaction[]          @relation("HeldTransactionCashier")
  resumedTransactions   HeldTransaction[]          @relation("HeldTransactionResumedBy")
  uploadedInvoices      InvoiceDocument[]          @relation("InvoiceUploadedBy")
  confirmedInvoices     InvoiceDocument[]          @relation("InvoiceConfirmedBy")
  rejectedInvoices      InvoiceDocument[]          @relation("InvoiceRejectedBy")

  @@unique([organizationId, id])
  @@index([organizationId, lastName, firstName])
}

model Role {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  name           String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees      EmployeeRole[]
  permissions    RolePermission[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
}

model Permission {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  code           String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roles          RolePermission[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
}

model EmployeeRole {
  organizationId String       @db.Uuid
  employeeId     String       @db.Uuid
  roleId         String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee       Employee     @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  role           Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([organizationId, employeeId, roleId])
}

model RolePermission {
  organizationId String       @db.Uuid
  roleId         String       @db.Uuid
  permissionId   String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role           Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  permission     Permission   @relation(fields: [organizationId, permissionId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([organizationId, roleId, permissionId])
}

model EmployeeStore {
  organizationId String       @db.Uuid
  employeeId     String       @db.Uuid
  storeId        String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  employee       Employee     @relation(fields: [organizationId, employeeId], references: [organizationId, id])
  store          Store        @relation(fields: [organizationId, storeId], references: [organizationId, id])

  @@id([organizationId, employeeId, storeId])
}

model EmployeeShift {
  id                    String       @id @default(uuid()) @db.Uuid
  organizationId        String       @db.Uuid
  employeeId            String       @db.Uuid
  storeId               String       @db.Uuid
  registerId            String?      @db.Uuid
  clockedInAt           DateTime     @default(now())
  clockedOutAt          DateTime?
  correctedClockedInAt  DateTime?
  correctedClockedOutAt DateTime?
  correctionReason      String?
  correctedByEmployeeId String?      @db.Uuid
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @default(now()) @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee              Employee     @relation("EmployeeShiftEmployee", fields: [organizationId, employeeId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  store                 Store        @relation(fields: [organizationId, storeId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  register              Register?    @relation(fields: [organizationId, registerId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  correctedBy           Employee?    @relation("EmployeeShiftCorrectedBy", fields: [organizationId, correctedByEmployeeId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organizationId, id])
  @@index([organizationId, employeeId, clockedInAt(sort: Desc)], map: "EmployeeShift_employee_history_idx")
  @@index([organizationId, storeId, clockedInAt(sort: Desc)], map: "EmployeeShift_store_history_idx")
}

model Register {
  id               String               @id @default(uuid()) @db.Uuid
  organizationId   String               @db.Uuid
  storeId          String               @db.Uuid
  name             String
  code             String
  status           RegisterStatus       @default(ACTIVE)
  deviceIdentifier String?
  organization     Organization         @relation(fields: [organizationId], references: [id])
  store            Store                @relation(fields: [organizationId, storeId], references: [organizationId, id])
  sessions         RegisterSession[]
  assignments      TerminalAssignment[]
  orders           Order[]
  employeeShifts   EmployeeShift[]
  quickKeys        QuickKey[]
  heldTransactions HeldTransaction[]

  @@unique([organizationId, id])
  @@unique([organizationId, storeId, id])
  @@unique([organizationId, storeId, code])
}

model Category {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  active         Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id])
  products       Product[]
  promotions     Promotion[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId, active, name], map: "Category_organizationId_active_name_idx")
}

model Product {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  categoryId       String           @db.Uuid
  name             String
  description      String?
  brand            String?
  active           Boolean          @default(true)
  ageRestricted    Boolean          @default(false)
  inventoryTracked Boolean          @default(true)
  taxCategory      String           @default("STANDARD")
  /// Incomplete purchasing information: a draft is inactive until it is completed.
  draft            Boolean          @default(false)
  taxProfileId     String?          @db.Uuid
  taxProfile       TaxProfile?      @relation(fields: [organizationId, taxProfileId], references: [organizationId, id])
  organization     Organization     @relation(fields: [organizationId], references: [id])
  category         Category         @relation(fields: [organizationId, categoryId], references: [organizationId, id])
  variants         ProductVariant[]
  promotions       Promotion[]

  @@unique([organizationId, id])
  @@unique([organizationId, categoryId, id])
  @@index([organizationId, name])
  @@index([organizationId, brand])
}

model ProductVariant {
  id                 String                     @id @default(uuid()) @db.Uuid
  organizationId     String                     @db.Uuid
  productId          String                     @db.Uuid
  name               String
  sku                String
  size               Decimal?                   @db.Decimal(12, 3)
  unit               ProductUnit                @default(EACH)
  active             Boolean                    @default(true)
  costMinor          BigInt?
  lowStockThreshold  Int                        @default(0)
  /// Pack/selling variants draw stock from a base variant: a 6-pack sale consumes 6 base units.
  baseVariantId      String?                    @db.Uuid
  unitsPerPack       Int                        @default(1)
  baseVariant        ProductVariant?            @relation("VariantPacks", fields: [organizationId, baseVariantId], references: [organizationId, id])
  packVariants       ProductVariant[]           @relation("VariantPacks")
  taxProfileId       String?                    @db.Uuid
  taxProfile         TaxProfile?                @relation(fields: [organizationId, taxProfileId], references: [organizationId, id])
  specialPrices      SpecialPrice[]
  vendorDeals        VendorDeal[]
  costHistory        ProductCostHistory[]
  vendorClaimLines   VendorClaimLine[]
  organization       Organization               @relation(fields: [organizationId], references: [id])
  product            Product                    @relation(fields: [organizationId, productId], references: [organizationId, id])
  barcodes           Barcode[]
  prices             Price[]
  inventoryLevels    InventoryLevel[]
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]
  reservations       InventoryReservationLine[]
  refundItems        RefundItem[]
  masterProductId    String?                    @db.Uuid
  masterProduct      MasterProduct?             @relation(fields: [masterProductId], references: [id])
  vendorMappings     VendorProductMapping[]
  purchaseOrderLines PurchaseOrderLine[]
  storeCosts         StoreProductCost[]
  transferLines      InventoryTransferLine[]
  stockCountLines    StockCountLine[]
  promotions         Promotion[]
  quickKeys          QuickKey[]
  invoiceLines       InvoiceLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, sku])
  @@unique([organizationId, productId, id])
  @@index([masterProductId])
  @@index([organizationId, productId, active])
}

model Barcode {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  variantId      String         @db.Uuid
  barcodeValue   String
  /// PRIMARY is the printed UPC; ALTERNATE is any additional UPC that sells the same variant.
  kind           BarcodeKind    @default(PRIMARY)
  organization   Organization   @relation(fields: [organizationId], references: [id])
  variant        ProductVariant @relation(fields: [organizationId, variantId], references: [organizationId, id])

  @@unique([organizationId, id])
  @@unique([organizationId, barcodeValue])
  @@unique([organizationId, variantId, id])
  @@index([organizationId, barcodeValue])
}

model Price {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  storeId        String?        @db.Uuid
  variantId      String         @db.Uuid
  amountMinor    BigInt
  currency       String         @default("USD") @db.Char(3)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  organization   Organization   @relation(fields: [organizationId], references: [id])
  store          Store?         @relation(fields: [organizationId, storeId], references: [organizationId, id])
  variant        ProductVariant @relation(fields: [organizationId, variantId], references: [organizationId, id])

  @@unique([organizationId, id])
  @@index([organizationId, storeId, variantId, effectiveFrom])
  @@index([organizationId, storeId, variantId, effectiveFrom, effectiveTo], map: "price_lookup_effective")
}

model InventoryLevel {
  id                String                     @id @default(uuid()) @db.Uuid
  organizationId    String                     @db.Uuid
  storeId           String                     @db.Uuid
  variantId         String                     @db.Uuid
  onHand            Int                        @default(0)
  reserved          Int                        @default(0)
  lowStockThreshold Int                        @default(0)
  reorderTarget     Int                        @default(0)
  organization      Organization               @relation(fields: [organizationId], references: [id])
  store             Store                      @relation(fields: [organizationId, storeId], references: [organizationId, id])
  variant           ProductVariant             @relation(fields: [organizationId, variantId], references: [organizationId, id])
  reservationLines  InventoryReservationLine[]

  @@unique([organizationId, storeId, variantId])
  @@index([organizationId, storeId, onHand])
}

model InventoryMovement {
  id              String                @id @default(uuid()) @db.Uuid
  organizationId  String                @db.Uuid
  storeId         String                @db.Uuid
  variantId       String                @db.Uuid
  quantityDelta   Int
  type            InventoryMovementType
  referenceType   String?
  referenceId     String?
  reason          String?
  resultingOnHand Int?
  employeeId      String?               @db.Uuid
  createdAt       DateTime              @default(now())
  organization    Organization          @relation(fields: [organizationId], references: [id])
  store           Store                 @relation(fields: [organizationId, storeId], references: [organizationId, id])
  variant         ProductVariant        @relation(fields: [organizationId, variantId], references: [organizationId, id])
  employee        Employee?             @relation(fields: [organizationId, employeeId], references: [organizationId, id])

  @@unique([organizationId, id])
  @@index([organizationId, storeId, variantId, createdAt])
  @@index([organizationId, referenceType, referenceId])
  @@index([organizationId, storeId, createdAt(sort: Desc)], map: "InventoryMovement_admin_history_idx")
}

model InventoryReservation {
  id             String                     @id @default(uuid()) @db.Uuid
  organizationId String                     @db.Uuid
  storeId        String                     @db.Uuid
  orderId        String                     @db.Uuid
  status         ReservationStatus          @default(ACTIVE)
  createdAt      DateTime                   @default(now())
  convertedAt    DateTime?
  releasedAt     DateTime?
  organization   Organization               @relation(fields: [organizationId], references: [id])
  store          Store                      @relation(fields: [organizationId, storeId], references: [organizationId, id])
  order          Order                      @relation(fields: [organizationId, orderId], references: [organizationId, id])
  lines          InventoryReservationLine[]

  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt])
}

model InventoryReservationLine {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  reservationId  String               @db.Uuid
  storeId        String               @db.Uuid
  variantId      String               @db.Uuid
  quantity       Int
  organization   Organization         @relation(fields: [organizationId], references: [id])
  reservation    InventoryReservation @relation(fields: [organizationId, reservationId], references: [organizationId, id])
  level          InventoryLevel       @relation(fields: [organizationId, storeId, variantId], references: [organizationId, storeId, variantId])
  variant        ProductVariant       @relation(fields: [organizationId, variantId], references: [organizationId, id])

  @@unique([organizationId, id])
  @@unique([organizationId, reservationId, variantId])
}

model RegisterSession {
  id                 String                @id @default(uuid()) @db.Uuid
  organizationId     String                @db.Uuid
  storeId            String                @db.Uuid
  registerId         String                @db.Uuid
  employeeId         String                @db.Uuid
  closedByEmployeeId String?               @db.Uuid
  status             RegisterSessionStatus @default(OPEN)
  openingCashMinor   BigInt
  expectedCashMinor  BigInt?
  actualCashMinor    BigInt?
  differenceMinor    BigInt?
  openedAt           DateTime              @default(now())
  closedAt           DateTime?
  organization       Organization          @relation(fields: [organizationId], references: [id])
  store              Store                 @relation(fields: [organizationId, storeId], references: [organizationId, id])
  register           Register              @relation(fields: [organizationId, registerId], references: [organizationId, id])
  employee           Employee              @relation("RegisterSessionOpenedBy", fields: [organizationId, employeeId], references: [organizationId, id])
  closedByEmployee   Employee?             @relation("RegisterSessionClosedBy", fields: [organizationId, closedByEmployeeId], references: [organizationId, id])
  orders             Order[]
  cashMovements      CashMovement[]

  @@unique([organizationId, id])
  @@unique([organizationId, registerId, id])
  @@index([organizationId, registerId, status])
  @@index([organizationId, storeId, openedAt], map: "RegisterSession_reporting_period_idx")
}

model Customer {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @db.Uuid
  storeId             String?              @db.Uuid
  name                String
  email               String?
  phone               String?
  emailNormalized     String?
  phoneNormalized     String?
  notes               String?
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now()) @updatedAt
  organization        Organization         @relation(fields: [organizationId], references: [id])
  store               Store?               @relation(fields: [organizationId, storeId], references: [organizationId, id])
  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
  heldTransactions    HeldTransaction[]

  @@unique([organizationId, id])
  @@index([organizationId, name])
  @@index([organizationId, active])
}

model LoyaltyProgram {
  id                  String       @id @default(uuid()) @db.Uuid
  organizationId      String       @unique @db.Uuid
  enabled             Boolean      @default(false)
  pointsEarned        Int          @default(1)
  spendMinor          BigInt       @default(100)
  redeemMinorPerPoint BigInt       @default(1)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @default(now()) @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model LoyaltyTransaction {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  customerId     String                 @db.Uuid
  orderId        String?                @db.Uuid
  refundId       String?                @db.Uuid
  employeeId     String?                @db.Uuid
  type           LoyaltyTransactionType
  status         LedgerStatus           @default(POSTED)
  points         Int
  reason         String?
  referenceKey   String?
  createdAt      DateTime               @default(now())
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer       Customer               @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  order          Order?                 @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  refund         Refund?                @relation(fields: [organizationId, refundId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
