model InventoryTransfer {
  id                     String                     @id @default(uuid()) @db.Uuid
  organizationId         String                     @db.Uuid
  sourceStoreId          String                     @db.Uuid
  destinationStoreId     String                     @db.Uuid
  createdByEmployeeId    String                     @db.Uuid
  submittedByEmployeeId  String?                    @db.Uuid
  shippedByEmployeeId    String?                    @db.Uuid
  transferNumber         String
  status                 InventoryTransferStatus    @default(DRAFT)
  notes                  String?
  shipIdempotencyKey     String?
  shipRequestFingerprint String?
  submittedAt            DateTime?
  shippedAt              DateTime?
  receivedAt             DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  organization           Organization               @relation(fields: [organizationId], references: [id])
  sourceStore            Store                      @relation("TransferSourceStore", fields: [organizationId, sourceStoreId], references: [organizationId, id])
  destinationStore       Store                      @relation("TransferDestinationStore", fields: [organizationId, destinationStoreId], references: [organizationId, id])
  createdBy              Employee                   @relation("TransferCreatedBy", fields: [organizationId, createdByEmployeeId], references: [organizationId, id])
  submittedBy            Employee?                  @relation("TransferSubmittedBy", fields: [organizationId, submittedByEmployeeId], references: [organizationId, id])
  shippedBy              Employee?                  @relation("TransferShippedBy", fields: [organizationId, shippedByEmployeeId], references: [organizationId, id])
  lines                  InventoryTransferLine[]
  receipts               InventoryTransferReceipt[]

  @@unique([organizationId, id])
  @@unique([organizationId, transferNumber])
  @@unique([organizationId, shipIdempotencyKey])
  @@index([organizationId, sourceStoreId, status, createdAt])
  @@index([organizationId, destinationStoreId, status, createdAt])
}

