  createdBy             Employee         @relation("StockCountCreatedBy", fields: [organizationId, createdByEmployeeId], references: [organizationId, id])
  reviewedBy            Employee?        @relation("StockCountReviewedBy", fields: [organizationId, reviewedByEmployeeId], references: [organizationId, id])
  finalizedBy           Employee?        @relation("StockCountFinalizedBy", fields: [organizationId, finalizedByEmployeeId], references: [organizationId, id])
  lines                 StockCountLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, countNumber])
  @@index([organizationId, storeId, status, createdAt])
}

model StockCountLine {
  id               String         @id @default(uuid()) @db.Uuid
  organizationId   String         @db.Uuid
  stockCountId     String         @db.Uuid
  variantId        String         @db.Uuid
  expectedQuantity Int
  countedQuantity  Int?
  variance         Int?
  organization     Organization   @relation(fields: [organizationId], references: [id])
  stockCount       StockCount     @relation(fields: [organizationId, stockCountId], references: [organizationId, id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [organizationId, variantId], references: [organizationId, id])

  @@unique([organizationId, id])
  @@unique([organizationId, stockCountId, variantId])
}

model Promotion {
  id                    String          @id @default(uuid()) @db.Uuid
  organizationId        String          @db.Uuid
  storeId               String?         @db.Uuid
  categoryId            String?         @db.Uuid
  productId             String?         @db.Uuid
  variantId             String?         @db.Uuid
  createdByEmployeeId   String          @db.Uuid
  name                  String
  type                  PromotionType
  scope                 PromotionScope
  percentageBasisPoints Int?
  fixedAmountMinor      BigInt?
  bundleQuantity        Int?
  bundlePriceMinor      BigInt?
  minimumQuantity       Int             @default(1)
  minimumSpendMinor     BigInt          @default(0)
  priority              Int             @default(0)
  startsAt              DateTime
  endsAt                DateTime
  active                Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  organization          Organization    @relation(fields: [organizationId], references: [id])
  store                 Store?          @relation(fields: [organizationId, storeId], references: [organizationId, id])
  category              Category?       @relation(fields: [organizationId, categoryId], references: [organizationId, id])
  product               Product?        @relation(fields: [organizationId, productId], references: [organizationId, id])
  variant               ProductVariant? @relation(fields: [organizationId, variantId], references: [organizationId, id])
  createdBy             Employee        @relation("PromotionCreatedBy", fields: [organizationId, createdByEmployeeId], references: [organizationId, id])
  orderItems            OrderItem[]

  @@unique([organizationId, id])
  @@index([organizationId, storeId, active, startsAt, endsAt])
  @@index([organizationId, categoryId])
  @@index([organizationId, productId])
  @@index([organizationId, variantId])
}

model QuickKey {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  storeId        String         @db.Uuid
  registerId     String?        @db.Uuid
  variantId      String         @db.Uuid
  label          String
  groupName      String         @default("Favorites")
  position       Int
  enabled        Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id])
  store          Store          @relation(fields: [organizationId, storeId], references: [organizationId, id])
  register       Register?      @relation(fields: [organizationId, storeId, registerId], references: [organizationId, storeId, id])
  variant        ProductVariant @relation(fields: [organizationId, variantId], references: [organizationId, id])

  @@unique([organizationId, id])
  @@unique([organizationId, storeId, registerId, position])
  @@index([organizationId, storeId, registerId, enabled, groupName, position])
}

model HeldTransaction {
  id                  String                @id @default(uuid()) @db.Uuid
  organizationId      String                @db.Uuid
  storeId             String                @db.Uuid
  registerId          String                @db.Uuid
  employeeId          String                @db.Uuid
  customerId          String?               @db.Uuid
  resumedByEmployeeId String?               @db.Uuid
  label               String
  note                String?
  cartJson            Json
  status              HeldTransactionStatus @default(HELD)
  idempotencyKey      String
  requestFingerprint  String
  heldAt              DateTime              @default(now())
  resumedAt           DateTime?
  cancelledAt         DateTime?
  expiredAt           DateTime?
  organization        Organization          @relation(fields: [organizationId], references: [id])
  store               Store                 @relation(fields: [organizationId, storeId], references: [organizationId, id])
  register            Register              @relation(fields: [organizationId, storeId, registerId], references: [organizationId, storeId, id])
  employee            Employee              @relation("HeldTransactionCashier", fields: [organizationId, employeeId], references: [organizationId, id])
  resumedBy           Employee?             @relation("HeldTransactionResumedBy", fields: [organizationId, resumedByEmployeeId], references: [organizationId, id])
  customer            Customer?             @relation(fields: [organizationId, customerId], references: [organizationId, id])

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, storeId, registerId, status, heldAt(sort: Desc)])
}

model InvoiceDocument {
  id                    String              @id @default(uuid()) @db.Uuid
  organizationId        String              @db.Uuid
  storeId               String              @db.Uuid
  vendorId              String?             @db.Uuid
  purchaseOrderId       String?             @db.Uuid
  uploadedByEmployeeId  String              @db.Uuid
  confirmedByEmployeeId String?             @db.Uuid
  rejectedByEmployeeId  String?             @db.Uuid
  originalFilename      String
  mimeType              String
  fileSize              Int
  storageReference      String
  documentHash          String
  documentData          Bytes
  ocrStatus             InvoiceOcrStatus    @default(PENDING)
  ocrProvider           String?
  ocrError              String?
  ocrConfidence         Decimal?            @db.Decimal(5, 4)
  rawProviderResult     Json?
  reviewStatus          InvoiceReviewStatus @default(DRAFT)
  vendorNameExtracted   String?
  invoiceNumber         String?
  invoiceDate           DateTime?
  subtotalMinor         BigInt?
  taxMinor              BigInt?
  totalMinor            BigInt?
  poReference           String?
  discountMinor         BigInt?
  rebateMinor           BigInt?
  feesMinor             BigInt?
  rawText               String?
  possibleDuplicate     Boolean             @default(false)
  uploadedAt            DateTime            @default(now())
  confirmedAt           DateTime?
  rejectedAt            DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  organization          Organization        @relation(fields: [organizationId], references: [id])
  store                 Store               @relation(fields: [organizationId, storeId], references: [organizationId, id])
  vendor                Vendor?             @relation(fields: [organizationId, vendorId], references: [organizationId, id])
  purchaseOrder         PurchaseOrder?      @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id])
  uploadedBy            Employee            @relation("InvoiceUploadedBy", fields: [organizationId, uploadedByEmployeeId], references: [organizationId, id])
  confirmedBy           Employee?           @relation("InvoiceConfirmedBy", fields: [organizationId, confirmedByEmployeeId], references: [organizationId, id])
  rejectedBy            Employee?           @relation("InvoiceRejectedBy", fields: [organizationId, rejectedByEmployeeId], references: [organizationId, id])
  lines                 InvoiceLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, documentHash])
  @@index([organizationId, storeId, reviewStatus, uploadedAt(sort: Desc)])
  @@index([organizationId, vendorId, invoiceNumber, invoiceDate])
}

model InvoiceLine {
  id                String                 @id @default(uuid()) @db.Uuid
  organizationId    String                 @db.Uuid
  invoiceDocumentId String                 @db.Uuid
  variantId         String?                @db.Uuid
  masterProductId   String?                @db.Uuid
  lineNumber        Int
  description       String
  upc               String?
  vendorSku         String?
  quantity          Int
  caseQuantity      Int                    @default(1)
  unitCostMinor     BigInt
  lineTotalMinor    BigInt
  size              String?
  casesReceived     Int?
  caseCostMinor     BigInt?
  discountPerCaseMinor BigInt?
  rawText           String?
  /// Explicit, reviewed choice to update the vendor's current cost on confirmation. Never set automatically.
  updateVendorCost  Boolean                @default(false)
  confidence        Decimal?               @db.Decimal(5, 4)
  matchStatus       InvoiceLineMatchStatus @default(NEEDS_REVIEW)
  newProductData    Json?
  ignored           Boolean                @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  organization      Organization           @relation(fields: [organizationId], references: [id])
  invoiceDocument   InvoiceDocument        @relation(fields: [organizationId, invoiceDocumentId], references: [organizationId, id], onDelete: Cascade)
  variant           ProductVariant?        @relation(fields: [organizationId, variantId], references: [organizationId, id])
  masterProduct     MasterProduct?         @relation(fields: [masterProductId], references: [id])

  @@unique([organizationId, id])
  @@unique([organizationId, invoiceDocumentId, lineNumber])
  @@index([organizationId, invoiceDocumentId, matchStatus])
}

enum TaxProfileKind {
  /// Uses the store's standard tax rate (Store.taxRateBasisPoints).
  STANDARD
  NON_TAXABLE
  CUSTOM
}

model TaxProfile {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  name            String
  kind            TaxProfileKind @default(CUSTOM)
  /// Required for CUSTOM profiles; STANDARD follows the store rate and NON_TAXABLE is always 0.
  rateBasisPoints Int?
  description     String?
  active          Boolean        @default(true)
  isDefault       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  organization    Organization   @relation(fields: [organizationId], references: [id])
  products        Product[]
  variants        ProductVariant[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
}

/// A named price list such as DoorDash, Uber Eats, Price A, or any custom channel. The standard store price stays in Price.
model PriceBook {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  name           String
  description    String?
  active         Boolean        @default(true)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id])
  specialPrices  SpecialPrice[]
  salesChannels  SalesChannel[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
}

model SpecialPrice {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  priceBookId    String         @db.Uuid
  storeId        String         @db.Uuid
  variantId      String         @db.Uuid
  amountMinor    BigInt
  active         Boolean        @default(true)
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id])
  priceBook      PriceBook      @relation(fields: [organizationId, priceBookId], references: [organizationId, id])
  store          Store          @relation(fields: [organizationId, storeId], references: [organizationId, id])
  variant        ProductVariant @relation(fields: [organizationId, variantId], references: [organizationId, id])

  @@unique([organizationId, id])
  @@index([organizationId, storeId, variantId, priceBookId, active])
}

enum VendorDealKind {
  DISCOUNT_PER_CASE
  DEAL_CASE_PRICE
  QUANTITY_BREAK
  REBATE
  ALLOWANCE
}

/// Purchasing-side deal. It never changes the vendor's base case cost; cost history keeps the components.
model VendorDeal {
  id                 String         @id @default(uuid()) @db.Uuid
  organizationId     String         @db.Uuid
  vendorId           String         @db.Uuid
  variantId          String?        @db.Uuid
  name               String
  kind               VendorDealKind
  amountMinor        BigInt?
  dealCaseCostMinor  BigInt?
  minimumCases       Int?
  startsAt           DateTime?
  endsAt             DateTime?
  active             Boolean        @default(true)
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  organization       Organization   @relation(fields: [organizationId], references: [id])
  vendor             Vendor         @relation(fields: [organizationId, vendorId], references: [organizationId, id])
  variant            ProductVariant? @relation(fields: [organizationId, variantId], references: [organizationId, id])

  @@unique([organizationId, id])
  @@index([organizationId, vendorId, variantId, active])
}

enum CostHistorySource {
  PRODUCT_CREATED
  PURCHASE_RECEIPT
  INVOICE_CONFIRMED
  MANUAL_UPDATE
}

/// Append-only purchase/cost history. Rows are never rewritten when a vendor's current price changes.
model ProductCostHistory {
  id                       String            @id @default(uuid()) @db.Uuid
  organizationId           String            @db.Uuid
  storeId                  String?           @db.Uuid
  variantId                String            @db.Uuid
  vendorId                 String?           @db.Uuid
  purchaseOrderId          String?           @db.Uuid
  invoiceDocumentId        String?           @db.Uuid
  source                   CostHistorySource
  occurredAt               DateTime          @default(now())
  casesOrdered             Int?
  casesReceived            Int?
  unitsPerCase             Int
  baseCaseCostMinor        BigInt
  discountPerCaseMinor     BigInt            @default(0)
  rebatePerCaseMinor       BigInt            @default(0)
  effectiveCaseCostMinor   BigInt
  effectiveUnitCostMinor   BigInt
  unitsReceived            Int?
  unitsDamaged             Int               @default(0)
  unitsRejected            Int               @default(0)
  unitsShort               Int               @default(0)
  createdByEmployeeId      String?           @db.Uuid
  notes                    String?
  createdAt                DateTime          @default(now())
  organization             Organization      @relation(fields: [organizationId], references: [id])
  variant                  ProductVariant    @relation(fields: [organizationId, variantId], references: [organizationId, id])

  @@unique([organizationId, id])
  @@index([organizationId, variantId, occurredAt(sort: Desc)])
  @@index([organizationId, vendorId, occurredAt(sort: Desc)])
}

enum ReturnDisposition {
  RETURN_TO_STOCK
  DAMAGED
  NON_RESELLABLE
  VENDOR_RETURN
}

enum CashMovementKind {
  PAID_IN
  PAID_OUT
  SAFE_DROP
  NO_SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

/// Every cash change to a drawer outside of sales and refunds. Append-only; expected cash is derived from these rows.
model CashMovement {
  id                   String           @id @default(uuid()) @db.Uuid
  organizationId       String           @db.Uuid
  storeId              String           @db.Uuid
  registerId           String           @db.Uuid
  registerSessionId    String           @db.Uuid
  employeeId           String           @db.Uuid
  approvedByEmployeeId String?          @db.Uuid
  kind                 CashMovementKind
  amountMinor          BigInt
  reason               String?
  createdAt            DateTime         @default(now())
  organization         Organization     @relation(fields: [organizationId], references: [id])
  session              RegisterSession  @relation(fields: [organizationId, registerSessionId], references: [organizationId, id])

  @@unique([organizationId, id])
  @@index([organizationId, registerSessionId, kind])
  @@index([organizationId, storeId, createdAt])
}

/// Store/day closeout (Z report). One per store and business date; the snapshot is immutable.
model DayClose {
  id                        String       @id @default(uuid()) @db.Uuid
  organizationId            String       @db.Uuid
  storeId                   String       @db.Uuid
  businessDate              DateTime     @db.Date
  timezone                  String
  closedByEmployeeId        String       @db.Uuid
  closedAt                  DateTime     @default(now())
  openRegisterCount         Int          @default(0)
  openRegistersAcknowledged Boolean      @default(false)
  totalsJson                Json
  organization              Organization @relation(fields: [organizationId], references: [id])
  store                     Store        @relation(fields: [organizationId, storeId], references: [organizationId, id])

  @@unique([organizationId, id])
  @@unique([organizationId, storeId, businessDate])
  @@index([organizationId, storeId, businessDate(sort: Desc)])
}

enum BarcodeKind {
  PRIMARY
  ALTERNATE
}

/// Where an order came from. A channel may be tied to a price book so its orders are priced from that book. No marketplace API integration.
model SalesChannel {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  code           String
  priceBookId    String?      @db.Uuid
  isDefault      Boolean      @default(false)
  active         Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  priceBook      PriceBook?   @relation(fields: [organizationId, priceBookId], references: [organizationId, id])
  orders         Order[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@unique([organizationId, name])
}

enum VendorClaimKind {
  RETURN
  SHORTAGE
  DAMAGE
  PRICE_DIFFERENCE
}

enum VendorClaimStatus {
  DRAFT
  SUBMITTED
  CREDITED
  REJECTED
  CANCELLED
}

/// Vendor returns and discrepancy/credit claims. Only RETURN claims move stock (on submit); credits are recorded, never inferred.
model VendorClaim {
  id                  String            @id @default(uuid()) @db.Uuid
  organizationId      String            @db.Uuid
  storeId             String            @db.Uuid
  vendorId            String            @db.Uuid
  kind                VendorClaimKind
  status              VendorClaimStatus @default(DRAFT)
  purchaseOrderId     String?           @db.Uuid
  invoiceDocumentId   String?           @db.Uuid
  reason              String
  expectedCreditMinor BigInt            @default(0)
  creditedMinor       BigInt?
  creditReference     String?
  createdByEmployeeId String            @db.Uuid
  submittedAt         DateTime?
  resolvedAt          DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  organization        Organization      @relation(fields: [organizationId], references: [id])
  vendor              Vendor            @relation(fields: [organizationId, vendorId], references: [organizationId, id])
  lines               VendorClaimLine[]

  @@unique([organizationId, id])
  @@index([organizationId, storeId, status, createdAt(sort: Desc)])
  @@index([organizationId, vendorId, status])
}

model VendorClaimLine {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  claimId        String         @db.Uuid
  variantId      String         @db.Uuid
  quantity       Int
  unitCostMinor  BigInt
  reason         String?
  organization   Organization   @relation(fields: [organizationId], references: [id])
  claim          VendorClaim    @relation(fields: [organizationId, claimId], references: [organizationId, id])
  variant        ProductVariant @relation(fields: [organizationId, variantId], references: [organizationId, id])

  @@unique([organizationId, id])
  @@unique([organizationId, claimId, variantId])
}
